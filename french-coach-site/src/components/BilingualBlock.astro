---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<section class="grid gap-8 border-t border-navy/15 py-12 md:grid-cols-2 md:gap-14 md:py-16">
  {label && <p class="eyebrow md:col-span-2">{label}</p>}
  <div lang="en" class="min-w-0"><slot name="english" /></div>
  <div lang="es" class="min-w-0 border-t border-navy/10 pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-14"><slot name="spanish" /></div>
</section>
