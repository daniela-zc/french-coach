---
interface Props {
  before: string;
  after: string;
  note: string;
}

const { before, after, note } = Astro.props;
---

<article class="rounded-sm border border-navy/15 bg-paper p-6 shadow-editorial sm:p-8">
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <p class="eyebrow">Before</p>
      <p lang="fr" class="mt-3 font-display text-xl text-ink/70">“{before}”</p>
    </div>
    <div class="border-t border-navy/10 pt-6 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
      <p class="eyebrow">After</p>
      <p lang="fr" class="mt-3 font-display text-xl text-navy">“{after}”</p>
    </div>
  </div>
  <p class="mt-6 border-t border-navy/10 pt-5 text-sm leading-6 text-ink/70">{note}</p>
</article>
