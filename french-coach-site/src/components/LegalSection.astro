---
interface Props {
  lang: 'en' | 'es';
  title: string;
  label: string;
}

const { lang, title, label } = Astro.props;
---

<section lang={lang} class="border-t border-navy/15 py-10 md:grid md:grid-cols-[0.7fr_1.3fr] md:gap-12 md:py-14">
  <div>
    <p class="eyebrow">{label}</p>
    <h2 class="mt-4 font-display text-3xl text-navy">{title}</h2>
  </div>
  <div class="mt-6 space-y-5 leading-8 text-ink/75 md:mt-0 [&_a]:text-link [&_h3]:font-display [&_h3]:text-xl [&_h3]:text-navy [&_li]:ml-5 [&_li]:list-disc [&_ul]:space-y-2">
    <slot />
  </div>
</section>
