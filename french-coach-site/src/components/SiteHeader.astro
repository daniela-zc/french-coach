---
import { withBase } from '../lib/paths';

const links = [
  { href: '/support/', label: 'Support' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
];
---

<header class="border-b border-navy/10 bg-ivory/95">
  <div class="page-shell flex min-h-20 items-center justify-between gap-6 py-3">
    <a class="flex items-center gap-3 no-underline" href={withBase('/')} aria-label="French Coach home">
      <img class="size-11 object-contain" src={withBase('/logo.png')} width="44" height="44" alt="" />
      <span class="font-display text-xl text-navy">French Coach</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="flex flex-wrap justify-end gap-x-5 gap-y-2 text-sm text-navy sm:gap-x-7">
        {links.map((link) => (
          <li><a class="no-underline transition-colors hover:text-burgundy" href={withBase(link.href)}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
